@page "/"
@rendermode InteractiveServer
@inject TwinImportService Importer
@inject AppState State
@inject NavigationManager Nav

<PageTitle>Agentic Security Simulator</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Infrastructure Resilience Simulator</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Monte Carlo attack simulation for CISO teams — digital twin, top-5 attack catalogue, resilience factor R.
</MudText>

<MudGrid>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">1. Import twin</MudText>
            <MudText Typo="Typo.body2">Lansweeper-style CSV or API POST.</MudText>
            <MudButton Class="mt-2" Variant="Variant.Filled" Color="Color.Primary" Href="/upload">Upload</MudButton>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">2. Run scenarios</MudText>
            <MudText Typo="Typo.body2">S1–S5, 500–1000 deterministic runs.</MudText>
            <MudButton Class="mt-2" Variant="Variant.Filled" Color="Color.Secondary" Href="/scenarios">Configure</MudButton>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">3. Review resilience</MudText>
            <MudText Typo="Typo.body2">Distribution, weakest dimension, replay.</MudText>
            <MudButton Class="mt-2" Variant="Variant.Filled" Color="Color.Tertiary" Href="/results">Results</MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudDivider Class="my-4" />
<MudStack Row="true" Spacing="2">
    <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="LoadCompanyTwin" Disabled="_busy">
        Load company digital twin CSV
    </MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="LoadSampleTwin" Disabled="_busy">
        Contoso sample
    </MudButton>
</MudStack>

@if (State.CurrentTwinId is Guid twinId)
{
    <MudAlert Severity="Severity.Success" Class="mt-3">Active twin: @twinId</MudAlert>
}

@code {
    private bool _busy;

    private async Task LoadSampleTwin()
    {
        _busy = true;
        try
        {
            State.CurrentTwinId = await Importer.ImportSampleAsync();
            Nav.NavigateTo("/topology");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadCompanyTwin()
    {
        _busy = true;
        try
        {
            State.CurrentTwinId = await Importer.ImportCompanyTwinAsync();
            Nav.NavigateTo("/topology");
        }
        finally
        {
            _busy = false;
        }
    }
}
